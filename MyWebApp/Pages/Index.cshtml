@page
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title>

    <!-- Bootstrap CSS (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- FontAwesome Icons (CDN) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <!-- ✅ Statik dosya olan styles.css'i bağla -->
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true">
</head>
<body>

<section class="vh-100">
    <div class="container-fluid">
        <div class="row">
            
            <!-- Sol taraf: Login Formu -->
            <div class="col-sm-4 login-container">
                <div class="px-5 ms-xl-4">
                    <i class="fas fa-wand-magic-sparkles fa-2x me-3 pt-5 mt-xl-4" style="color: #817090;"></i>
                    <span class="h1 fw-bold mb-0">Ipek Bas</span>
                </div>

                <div class="d-flex align-items-center h-custom-2 px-5 ms-xl-4 mt-5 pt-5 pt-xl-0 mt-xl-n5">
                    <div class="login-box"> <!-- Formu kapsayan saydam kutu -->
                        <form id="loginForm" style="width: 23rem;">
                            <h3 class="fw-normal mb-3 pb-3 text-center" style="letter-spacing: 1px;">Log in</h3>

                            <!-- E-Posta Girişi (Doğrulama için ID eklendi) -->
                            <div class="form-outline mb-4">
                                <input type="email" id="email" class="form-control form-control-lg" required />
                                <label class="form-label" for="email">Email address</label>
                                <small id="emailError" class="text-danger"></small> <!-- Hata mesajı için alan -->
                            </div>

                            <!-- Şifre Girişi -->
                            <div class="form-outline mb-4">
                                <input type="password" id="password" class="form-control form-control-lg" required />
                                <label class="form-label" for="password">Password</label>
                            </div>

                            <!-- Login Butonu (Formu Gönderirken Doğrulama Yapacak) -->
                            <div class="pt-1 mb-4">
                                <button class="btn btn-info btn-lg btn-block w-100" type="submit">Login</button>
                            </div>

                            <p class="small mb-5 pb-lg-2 text-center">
                                <a class="text-muted" href="#">Forgot password?</a>
                            </p>
                            <p class="text-center">
                                Don't have an account? <a href="#" class="link-info">Register here</a>
                            </p>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Sağ taraf: GIF Arka Planı -->
            <div class="col-sm-8 px-0 d-none d-sm-block">
                <img src="~/img/loginimage.gif" alt="Login image" class="w-100 vh-100" 
                     style="object-fit: cover; object-position: left;">
            </div>

        </div>
    </div>
</section>

<!-- Bootstrap JS (CDN) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<!-- JavaScript Dosyasını Dahil Et -->
<script src="~/js/script.js"></script>

</body>
</html>
