@page
@model Week5Project.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<link rel="stylesheet" href="~/css/custom.css" />

<div class="d-flex justify-content-center gap-4 flex-wrap px-4 mt-4">

    <div class="glass-box flex-fill" style="max-width: 500px; min-width: 300px;">
        <h4>@(Model.EditMode ? "Edit Class" : "Add Class")</h4>

        <form method="post" asp-page-handler="@(Model.EditMode ? "Update" : "Add")">
            <input type="hidden" asp-for="NewClass.Id" />
            <input type="hidden" asp-for="SearchString" />

            <div class="mb-3">
                <label asp-for="NewClass.ClassName" class="form-label"></label>
                <input asp-for="NewClass.ClassName" class="form-control" placeholder="Class Name" />
                <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewClass.StudentCount" class="form-label"></label>
                <input asp-for="NewClass.StudentCount" class="form-control" type="number" placeholder="Student Count" />
                <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewClass.Description" class="form-label"></label>
                <textarea asp-for="NewClass.Description" class="form-control" placeholder="Description"></textarea>
                <span asp-validation-for="NewClass.Description" class="text-danger"></span>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-primary">
                    @(Model.EditMode ? "Update" : "Add")
                </button>
            </div>

            @if (Model.EditMode)
            {
                <div class="text-center mt-2">
                    <a asp-page-handler="Cancel" class="btn btn-secondary">Cancel</a>
                </div>
            }
        </form>
    </div>

    <div class="glass-box flex-fill" style="min-width: 500px;">
        <h4>Class List</h4>

        <form method="get" class="mb-3 d-flex gap-2">
            <input type="text" name="SearchString" value="@Request.Query["SearchString"]" class="form-control" placeholder="Search class name..." />
            <button type="submit" class="btn btn-primary">Filter</button>
        </form>

        <table class="table table-hover table-bordered bg-white bg-opacity-75">
            <thead class="table-dark">
                <tr>
                    <th>Class Name</th>
                    <th>Student Count</th>
                    <th>Description</th>
                    <th>Edit or Delete</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.PagedClassList)
                {
                    <tr>
                        <td>@item.ClassName</td>
                        <td>@item.StudentCount</td>
                        <td>@item.Description</td>
                        <td class="text-nowrap">
                            <form method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" asp-page-handler="Edit" class="btn btn-warning btn-sm me-1">
                                    <i class="fas fa-pencil-alt"></i> Edit
                                </button>
                            </form>
                            <form method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-center mt-3 gap-2">
            @if (Model.PageNumber > 1)
            {
                <a class="custom-page-button" asp-page="./Index"
                   asp-route-PageNumber="@(Model.PageNumber - 1)"
                   asp-route-SearchString="@Model.SearchString">Previous</a>
            }
            @if (Model.PageNumber * Model.PageSize < Model.TotalItemCount)
            {
                <a class="custom-page-button" asp-page="./Index"
                   asp-route-PageNumber="@(Model.PageNumber + 1)"
                   asp-route-SearchString="@Model.SearchString">Next</a>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
